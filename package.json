{
  "name": "terminal-ai-assistant",
  "version": "1.0.0",
  "description": "A free, open-source terminal-based AI coding assistant (Claude Code alternative)",
  "main": "dist/index.js",
  "bin": {
    "terminal-ai": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "cli",
    "terminal",
    "ollama",
    "llm",
    "claude-code",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-repo/terminal-ai-assistant"
  },
  "bugs": {
    "url": "https://github.com/your-repo/terminal-ai-assistant/issues"
  },
  "homepage": "https://github.com/your-repo/terminal-ai-assistant#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "inquirer": "^12.4.2",
    "openai": "^4.83.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
