# Environment Configuration for Terminal AI Coding Assistant

# LLM Provider Configuration
# Options: "ollama" (local) or "openrouter" (cloud free tier)
LLM_PROVIDER=ollama

# Ollama Configuration (for local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# OpenRouter Configuration (for free cloud models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-2-9b-it:free

# Assistant Configuration
MAX_TOKENS=4096
TEMPERATURE=0.7
WORKSPACE_DIR=.

# Command Execution Settings
ALLOWED_COMMANDS=ls,cat,grep,find,pwd,echo,mkdir,cp,mv,rm
BLOCKED_COMMANDS=rm -rf /,sudo,su,chmod 777,dd
